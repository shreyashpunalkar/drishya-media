{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": ".",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://drishya-media.onrender.com/api/$1"
    },
    {
      "source": "/admin",
      "destination": "https://drishya-media.onrender.com/admin"
    }
  ],
  "cleanUrls": true
}
