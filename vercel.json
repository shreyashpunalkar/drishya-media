{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "https://drishya-media.onrender.com/api/$1"
    },
    {
      "src": "/admin",
      "dest": "https://drishya-media.onrender.com/admin"
    },
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ]
}
